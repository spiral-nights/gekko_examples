import gleam/bit_array
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/string
import wit/api_types.{type GreetingError, type User, EmptyName, TooYoung}
import wit/logger
import wit/logger_types.{Info, Warn}

pub fn greet(u: User) -> Result(String, GreetingError) {
  logger.log(Info, "Checking user " <> u.name)
  case u.name == "" {
    True -> {
      logger.log(Warn, "Empty user name rejected")
      Error(EmptyName)
    }
    False ->
      case u.age < 13 {
        True -> Error(TooYoung(u.age))
        False -> {
          let nick = case u.nickname {
            Some(n) -> " (" <> n <> ")"
            None -> ""
          }
          let access = case u.meta.perms.read {
            True -> "read"
            False -> "no-read"
          }
          let tag_count = int.to_string(list.length(u.tags))
          Ok(
            "Hello, "
            <> u.name
            <> nick
            <> "! age="
            <> int.to_string(u.age)
            <> " tags="
            <> tag_count
            <> " id="
            <> int.to_string(u.meta.id)
            <> " perms="
            <> access,
          )
        }
      }
  }
}

pub fn sum_bytes(data: BitArray) -> Int {
  let size = bit_array.byte_size(data)
  case bit_array.to_string(data) {
    Ok(s) -> size + string.length(s)
    Error(_) -> size
  }
}
